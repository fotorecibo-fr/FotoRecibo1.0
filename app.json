{
  "expo": {
    "name": "Xavi's Snaps",
    "slug": "fotorecibo10",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#f5e6d3",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.fotorecibo.app",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f5e6d3"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Xavi's Snaps to access your camera to take photobooth photos"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow access to save your photobooth photos"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "38cb5b23-5179-42dc-aebc-4f17223f161e"
      }
    }
  }
}
